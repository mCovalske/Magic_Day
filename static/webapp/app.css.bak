:root{
  --bg:#080617; --bg2:#120a2a; --panel:rgba(21,14,48,.82); --panel2:rgba(33,21,65,.92);
  --gold:#e8bd63; --gold2:#ffd98a; --text:#f7f1e4; --muted:#b7abc9; --violet:#8d63e6;
  --danger:#d87979; --ok:#75c896; --border:rgba(231,190,99,.38); --shadow:0 16px 45px rgba(0,0,0,.35);
}
*{box-sizing:border-box} html,body{margin:0;padding:0;background:radial-gradient(circle at top,#2a1558 0,#100927 34%,var(--bg) 72%);color:var(--text);font-family:Inter,system-ui,sans-serif;min-height:100%}
body{padding-bottom:env(safe-area-inset-bottom)}
button,input,textarea,select{font:inherit} button{cursor:pointer}
.app-shell{max-width:680px;margin:0 auto;min-height:100vh;position:relative;padding-bottom:82px;background:linear-gradient(180deg,rgba(9,6,24,.62),rgba(9,6,24,.9))}
.topbar{position:sticky;top:0;z-index:20;display:flex;align-items:center;justify-content:space-between;padding:12px 14px 10px;background:rgba(8,6,20,.78);backdrop-filter:blur(18px);border-bottom:1px solid rgba(232,189,99,.14)}
.brand{display:flex;align-items:center;gap:10px}.brand-mark{width:38px;height:38px;border:1px solid var(--border);border-radius:50%;display:grid;place-items:center;color:var(--gold2);font-size:21px;background:rgba(255,255,255,.03)}.brand-title{font-family:"Cormorant Garamond",serif;font-size:23px;font-weight:700;letter-spacing:.2px}.brand-sub{font-size:11px;color:var(--muted);margin-top:-3px}
.icon-btn{width:38px;height:38px;border-radius:12px;border:1px solid var(--border);background:rgba(255,255,255,.04);color:var(--gold2);font-size:27px;line-height:1}
.hidden{display:none!important}
.screen{padding:14px}
.hero{position:relative;overflow:hidden;border:1px solid var(--border);border-radius:22px;background:var(--panel);box-shadow:var(--shadow);margin-bottom:16px}.hero img{width:100%;display:block;aspect-ratio:1.32;object-fit:cover;filter:saturate(.98) contrast(1.03)}.hero:after{content:"";position:absolute;inset:auto 0 0;height:38%;background:linear-gradient(transparent,rgba(8,5,18,.94))}
.hero-content{position:absolute;left:18px;right:18px;bottom:16px;z-index:1}.eyebrow{color:var(--gold2);font-size:12px;letter-spacing:.14em;text-transform:uppercase}.hero h1{margin:3px 0 6px;font:700 34px/1.0 "Cormorant Garamond",serif}.hero p{margin:0;color:#ddd1e8;line-height:1.45;font-size:13px}
.section-title{font:700 24px/1 "Cormorant Garamond",serif;margin:18px 0 11px;color:var(--gold2)}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:11px}.card{background:linear-gradient(180deg,rgba(32,22,64,.92),rgba(13,9,28,.92));border:1px solid var(--border);border-radius:18px;padding:13px;box-shadow:var(--shadow)}.card h3{font:700 21px/1.05 "Cormorant Garamond",serif;margin:7px 0;color:#fff5dc}.card p{margin:0;color:var(--muted);font-size:12px;line-height:1.45}.action-card{min-height:145px;display:flex;flex-direction:column;justify-content:flex-end;background-size:cover;background-position:center}.action-card .shade{margin:-13px;padding:13px;border-radius:18px;background:linear-gradient(180deg,transparent 25%,rgba(8,6,20,.94) 75%)}
.btn{width:100%;border:1px solid var(--border);border-radius:14px;padding:12px 14px;color:var(--text);background:linear-gradient(180deg,rgba(255,255,255,.07),rgba(255,255,255,.025));margin-top:9px}.btn.primary{background:linear-gradient(180deg,#8f67e7,#6343b4);border-color:#c9a1ff}.btn.gold{background:linear-gradient(180deg,#e7ba61,#9c6a22);color:#1b1021;border-color:#ffd98a;font-weight:700}.btn.danger{border-color:rgba(216,121,121,.55);color:#ffd5d5}.btn.ghost{background:transparent}
.toolbar{display:flex;gap:8px;flex-wrap:wrap}.toolbar .btn{width:auto;flex:1;min-width:110px}
.list{display:flex;flex-direction:column;gap:10px}.list-item{display:flex;gap:12px;padding:12px;border:1px solid var(--border);border-radius:16px;background:rgba(23,14,48,.78);align-items:center}.thumb{width:72px;height:72px;object-fit:cover;border-radius:13px;border:1px solid var(--border);flex:none}.grow{flex:1}.list-item h3{margin:0 0 4px;font-size:15px}.meta{color:var(--muted);font-size:12px}.price{color:var(--gold2);font-weight:700;font-size:16px}
.badge{display:inline-flex;padding:4px 8px;border-radius:999px;background:rgba(232,189,99,.11);border:1px solid var(--border);font-size:11px;color:var(--gold2)}
.kpi{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.kpi .card strong{font-size:28px;color:var(--gold2);display:block;margin-top:5px}
.input{width:100%;background:#0e0920;border:1px solid rgba(232,189,99,.32);border-radius:13px;padding:12px;color:#fff;outline:none}.input:focus{border-color:var(--gold2);box-shadow:0 0 0 3px rgba(232,189,99,.08)}
.label{font-size:12px;color:var(--muted);margin:8px 0 5px;display:block}
.notice{padding:12px 13px;border-radius:14px;border:1px solid var(--border);background:rgba(141,99,230,.09);color:#e8deef;font-size:13px;line-height:1.5}.notice.ok{border-color:rgba(117,200,150,.4)}.notice.warn{border-color:rgba(216,121,121,.4)}
.forecast{padding:16px;border-radius:18px;background:linear-gradient(180deg,rgba(41,26,82,.86),rgba(15,9,31,.92));border:1px solid var(--border);line-height:1.72}.forecast h2,.forecast h3{font-family:"Cormorant Garamond",serif;color:var(--gold2)}
.empty{text-align:center;padding:30px 14px;color:var(--muted)}
.modal-backdrop{position:fixed;inset:0;background:rgba(3,2,9,.72);backdrop-filter:blur(8px);display:grid;place-items:end center;z-index:50}.modal{width:min(680px,100%);background:#0f0824;border:1px solid var(--border);border-radius:24px 24px 0 0;padding:18px;max-height:86vh;overflow:auto}.modal h2{font:700 28px "Cormorant Garamond",serif;color:var(--gold2)}
.toast{position:fixed;left:50%;bottom:95px;transform:translateX(-50%) translateY(20px);opacity:0;background:#1d123a;border:1px solid var(--border);border-radius:12px;padding:11px 14px;z-index:80;transition:.25s;max-width:88%;box-shadow:var(--shadow);font-size:13px}.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
.bottom-nav{position:fixed;left:50%;bottom:0;transform:translateX(-50%);width:min(680px,100%);display:grid;grid-template-columns:repeat(5,1fr);background:rgba(8,6,20,.92);backdrop-filter:blur(18px);border-top:1px solid rgba(232,189,99,.2);padding-bottom:env(safe-area-inset-bottom);z-index:25}.bottom-nav button{border:0;background:none;color:#9d91ad;padding:9px 4px 8px;font-size:18px}.bottom-nav span{display:block;font-size:9px;margin-top:2px}.bottom-nav button.active{color:var(--gold2)}
.small{font-size:11px;color:var(--muted)}.center{text-align:center}.divider{height:1px;background:linear-gradient(90deg,transparent,rgba(232,189,99,.45),transparent);margin:14px 0}
@media(min-width:700px){.app-shell{min-height:100vh;border-left:1px solid rgba(232,189,99,.08);border-right:1px solid rgba(232,189,99,.08)}}


/* ===== MYSTICAL MOTION LAYER ===== */
.app-shell::before,.app-shell::after{content:"";position:fixed;inset:0;pointer-events:none;z-index:-1}
.app-shell::before{background:
 radial-gradient(circle at 15% 18%,rgba(141,99,230,.18),transparent 28%),
 radial-gradient(circle at 85% 32%,rgba(232,189,99,.08),transparent 24%),
 radial-gradient(circle at 50% 86%,rgba(93,64,177,.16),transparent 30%);animation:cosmicDrift 16s ease-in-out infinite alternate}
.app-shell::after{opacity:.32;background-image:radial-gradient(circle,rgba(255,255,255,.85) 0 1px,transparent 1.8px);background-size:86px 86px;animation:starFloat 24s linear infinite}
.screen{animation:screenIn .42s cubic-bezier(.22,1,.36,1)}
.hero{animation:heroIn .55s cubic-bezier(.22,1,.36,1);transform-origin:center top}
.hero img{animation:heroBreath 9s ease-in-out infinite alternate}
.card{transition:transform .24s ease,box-shadow .24s ease,border-color .24s ease}
.card:hover,.card:active{transform:translateY(-2px) scale(1.01);box-shadow:0 20px 55px rgba(0,0,0,.45),0 0 22px rgba(141,99,230,.11);border-color:rgba(255,217,138,.58)}
.btn{transition:transform .18s ease,box-shadow .22s ease,background .22s ease,border-color .22s ease}
.btn:active{transform:scale(.985)}
.btn.gold{box-shadow:0 8px 24px rgba(156,106,34,.18)}
.btn.gold:hover{box-shadow:0 10px 30px rgba(232,189,99,.25)}
.icon-btn{transition:transform .18s ease,box-shadow .22s ease}.icon-btn:active{transform:scale(.94)}
.brand-mark{animation:orbGlow 4s ease-in-out infinite}
.badge{animation:softPulse 4s ease-in-out infinite}
.forecast{animation:forecastIn .5s cubic-bezier(.22,1,.36,1)}
.modal-backdrop{animation:fadeIn .22s ease}.modal{animation:modalUp .35s cubic-bezier(.22,1,.36,1)}
.consent-shimmer{position:relative;overflow:hidden}
.consent-shimmer::after{content:"";position:absolute;inset:-80% -30%;background:linear-gradient(115deg,transparent 42%,rgba(255,255,255,.16) 50%,transparent 58%);transform:translateX(-55%);animation:shimmer 4.8s ease-in-out infinite;pointer-events:none}
.magic-orb{position:relative;overflow:hidden}
.magic-orb::before{content:"";position:absolute;width:120px;height:120px;border-radius:50%;right:-28px;top:-34px;background:radial-gradient(circle,rgba(255,255,255,.32),rgba(255,255,255,.02) 45%,transparent 68%);filter:blur(3px);animation:orbSweep 5s ease-in-out infinite}
.loading-dots::after{content:"";animation:dots 1.2s steps(4,end) infinite}
@keyframes screenIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
@keyframes heroIn{from{opacity:0;transform:translateY(14px) scale(.985)}to{opacity:1;transform:none}}
@keyframes heroBreath{from{transform:scale(1.015);filter:saturate(.95) brightness(.96)}to{transform:scale(1.045);filter:saturate(1.04) brightness(1.02)}}
@keyframes cosmicDrift{from{transform:translate3d(-1%,0,0) scale(1)}to{transform:translate3d(1%,1.2%,0) scale(1.04)}}
@keyframes starFloat{from{background-position:0 0}to{background-position:86px -86px}}
@keyframes orbGlow{0%,100%{box-shadow:0 0 0 rgba(232,189,99,0);filter:brightness(1)}50%{box-shadow:0 0 22px rgba(232,189,99,.18);filter:brightness(1.08)}}
@keyframes softPulse{0%,100%{box-shadow:0 0 0 rgba(232,189,99,0)}50%{box-shadow:0 0 18px rgba(232,189,99,.08)}}
@keyframes forecastIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
@keyframes modalUp{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:none}}
@keyframes shimmer{0%,20%{transform:translateX(-65%)}60%,100%{transform:translateX(65%)}}
@keyframes orbSweep{0%,100%{transform:translate3d(-10px,8px,0) rotate(0deg);opacity:.28}50%{transform:translate3d(-75px,58px,0) rotate(20deg);opacity:.55}}
@keyframes dots{0%{content:""}25%{content:"."}50%{content:".."}75%,100%{content:"..."}}
@media (prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.001ms!important;animation-iteration-count:1!important;transition-duration:.001ms!important}.screen,.hero,.modal{animation:none!important}}
.motion-step{opacity:0;transform:translateY(7px);animation:stepIn .42s cubic-bezier(.22,1,.36,1) forwards;margin:6px 0;color:#e8deef}
.answer-reveal{animation:answerReveal .65s cubic-bezier(.22,1,.36,1) both,answerGlow 2.4s ease-in-out .65s infinite alternate}
.pulse-once{animation:pulseOnce .6s cubic-bezier(.22,1,.36,1)}
.screen-refresh{animation:screenIn .42s cubic-bezier(.22,1,.36,1)}
@keyframes stepIn{to{opacity:1;transform:none}}
@keyframes answerReveal{0%{opacity:0;transform:scale(.96);filter:blur(4px)}60%{opacity:1;transform:scale(1.015);filter:blur(0)}100%{transform:scale(1)}}
@keyframes answerGlow{from{box-shadow:0 16px 45px rgba(0,0,0,.35)}to{box-shadow:0 18px 50px rgba(141,99,230,.18),0 0 28px rgba(232,189,99,.08)}}
@keyframes pulseOnce{0%{transform:scale(1)}40%{transform:scale(1.025)}100%{transform:scale(1)}}
